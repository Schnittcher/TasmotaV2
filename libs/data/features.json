{
    "fingerprint": {
        "caption": "Fingerprint sensor (AS608)",
        "detect": {
            "gpio": [
                "AS608 Rx",
                "AS608 Tx"
            ]
        },
        "init": [
            {
                "command": "FpCount",
                "payload": ""
            }
        ],
        "variables": {
            "FingerprintId": {
                "caption": "Last fingerprint ID",
                "type": "integer",
                "presentation": {
                    "kind": "number",
                    "digits": 0
                }
            },
            "FingerprintName": {
                "caption": "Last fingerprint name",
                "type": "string",
                "presentation": {
                    "kind": "text"
                }
            },
            "FingerprintConfidence": {
                "caption": "Fingerprint confidence",
                "type": "integer",
                "presentation": {
                    "kind": "number",
                    "digits": 0
                }
            },
            "FingerprintCount": {
                "caption": "Stored fingerprints",
                "type": "integer",
                "presentation": {
                    "kind": "number",
                    "digits": 0
                }
            },
            "FingerprintStatus": {
                "caption": "Fingerprint status",
                "type": "string",
                "presentation": {
                    "kind": "text"
                }
            },
            "FingerprintEnroll": {
                "caption": "Enroll fingerprint (ID)",
                "type": "integer",
                "presentation": {
                    "kind": "input"
                },
                "action": {
                    "command": "FpEnroll",
                    "payload": "{value}",
                    "min": 0,
                    "max": 128
                }
            },
            "FingerprintDelete": {
                "caption": "Delete fingerprint (ID)",
                "type": "integer",
                "presentation": {
                    "kind": "input"
                },
                "action": {
                    "command": "FpDelete",
                    "payload": "{value}",
                    "min": 1,
                    "max": 128
                }
            }
        },
        "results": [
            {
                "path": "FPrint",
                "variable": "FingerprintStatus",
                "scalarOnly": true
            },
            {
                "path": "FPrint.Id",
                "variable": "FingerprintId"
            },
            {
                "path": "FPrint.Confidence",
                "variable": "FingerprintConfidence"
            },
            {
                "path": "FpCount",
                "variable": "FingerprintCount"
            },
            {
                "path": "FpEnroll",
                "variable": "FingerprintStatus"
            },
            {
                "path": "FpDelete",
                "variable": "FingerprintStatus"
            }
        ],
        "names": {
            "property": "FingerprintNames",
            "idVariable": "FingerprintId",
            "nameVariable": "FingerprintName"
        }
    },
    "ifan": {
        "caption": "Fan (Sonoff iFan02/iFan03)",
        "detect": {
            "discovery": [
                "if"
            ]
        },
        "init": [
            {
                "command": "FanSpeed",
                "payload": ""
            }
        ],
        "variables": {
            "FanSpeed": {
                "caption": "Fan speed",
                "type": "integer",
                "presentation": {
                    "kind": "enumeration",
                    "options": [
                        [
                            0,
                            "Fan off"
                        ],
                        [
                            1,
                            "Fan speed 1"
                        ],
                        [
                            2,
                            "Fan speed 2"
                        ],
                        [
                            3,
                            "Fan speed 3"
                        ]
                    ]
                },
                "action": {
                    "command": "FanSpeed",
                    "payload": "{value}",
                    "min": 0,
                    "max": 3
                }
            }
        },
        "results": [
            {
                "path": "FanSpeed",
                "variable": "FanSpeed"
            }
        ]
    },
    "poweronstate": {
        "caption": "Power on state",
        "detect": {
            "always": true
        },
        "init": [
            {
                "command": "PowerOnState",
                "payload": ""
            }
        ],
        "variables": {
            "PowerOnState": {
                "caption": "Power on state",
                "type": "integer",
                "presentation": {
                    "kind": "enumeration",
                    "options": [
                        [
                            0,
                            "Stay off"
                        ],
                        [
                            1,
                            "Switch on"
                        ],
                        [
                            2,
                            "Toggle last state"
                        ],
                        [
                            3,
                            "Restore last state"
                        ],
                        [
                            4,
                            "Switch on and lock relays"
                        ],
                        [
                            5,
                            "Switch on after pulse time"
                        ]
                    ]
                },
                "action": {
                    "command": "PowerOnState",
                    "payload": "{value}",
                    "min": 0,
                    "max": 5
                }
            }
        },
        "results": [
            {
                "path": "PowerOnState",
                "variable": "PowerOnState"
            },
            {
                "path": "Status.PowerOnState",
                "variable": "PowerOnState"
            }
        ]
    },
    "powerlimit": {
        "caption": "Power limits (energy monitoring)",
        "detect": {
            "data": [
                "ENERGY",
                "StatusSNS.ENERGY"
            ]
        },
        "init": [
            {
                "command": "MaxPower",
                "payload": ""
            },
            {
                "command": "MaxPowerHold",
                "payload": ""
            },
            {
                "command": "MaxPowerWindow",
                "payload": ""
            }
        ],
        "variables": {
            "MaxPower": {
                "caption": "Power limit",
                "type": "integer",
                "presentation": {
                    "kind": "input",
                    "suffix": " W"
                },
                "action": {
                    "command": "MaxPower",
                    "payload": "{value}",
                    "min": 0,
                    "max": 65535
                }
            },
            "MaxPowerHold": {
                "caption": "Power limit hold time",
                "type": "integer",
                "presentation": {
                    "kind": "input",
                    "suffix": " s"
                },
                "action": {
                    "command": "MaxPowerHold",
                    "payload": "{value}",
                    "min": 0,
                    "max": 65535
                }
            },
            "MaxPowerWindow": {
                "caption": "Power limit window",
                "type": "integer",
                "presentation": {
                    "kind": "input",
                    "suffix": " s"
                },
                "action": {
                    "command": "MaxPowerWindow",
                    "payload": "{value}",
                    "min": 0,
                    "max": 65535
                }
            }
        },
        "results": [
            {
                "path": "MaxPower",
                "variable": "MaxPower"
            },
            {
                "path": "MaxPowerHold",
                "variable": "MaxPowerHold"
            },
            {
                "path": "MaxPowerWindow",
                "variable": "MaxPowerWindow"
            },
            {
                "path": "StatusPTH.MaxPower",
                "variable": "MaxPower"
            },
            {
                "path": "StatusPTH.MaxPowerHold",
                "variable": "MaxPowerHold"
            },
            {
                "path": "StatusPTH.MaxPowerWindow",
                "variable": "MaxPowerWindow"
            }
        ]
    },
    "irreceive": {
