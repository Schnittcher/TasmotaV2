    "ws2812": {
        "caption": "LED strip (WS2812)",
        "detect": {
            "gpio": [
                "WS2812"
            ]
        },
        "init": [
            {
                "command": "Pixels",
                "payload": ""
            }
        ],
        "variables": {
            "Pixels": {
                "caption": "Pixels",
                "type": "integer",
                "presentation": {
                    "kind": "input"
                },
                "action": {
                    "command": "Pixels",
                    "payload": "{value}",
                    "min": 1,
